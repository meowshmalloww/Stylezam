# Core
STYLEZAM_ENVIRONMENT=development
STYLEZAM_DATA_DIR=.data
# Optional locally; required for a public deployment so strangers cannot consume provider quotas.
STYLEZAM_API_TOKEN=
# Required when Google Lens must fetch an uploaded image. Use an HTTPS tunnel URL.
STYLEZAM_PUBLIC_BASE_URL=
STYLEZAM_ALLOWED_ORIGINS=http://localhost:3000

# Product search. SerpApi supports both Shopping text search and Lens image search.
STYLEZAM_SERPAPI_API_KEY=
# Hard stop enforced by Stylezam. Combined text + Lens searches can consume two calls.
STYLEZAM_SERPAPI_MONTHLY_CAP=250

# Optional marketplace search. Create production keys in the eBay developer portal.
STYLEZAM_EBAY_CLIENT_ID=
STYLEZAM_EBAY_CLIENT_SECRET=
STYLEZAM_EBAY_MARKETPLACE_ID=EBAY_US
STYLEZAM_EBAY_MONTHLY_CAP=5000

# Optional server-side image understanding. Configure one or more; Stylezam falls back
# in this order: OpenAI, Fireworks, then Qwen. Each route has its own local hard stop.
STYLEZAM_OPENAI_API_KEY=
STYLEZAM_OPENAI_BASE_URL=https://api.openai.com/v1
STYLEZAM_OPENAI_VISION_MODEL=gpt-5.6-luna
STYLEZAM_OPENAI_MONTHLY_CAP=100

STYLEZAM_FIREWORKS_API_KEY=
STYLEZAM_FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
STYLEZAM_FIREWORKS_VISION_MODEL=accounts/fireworks/models/kimi-k2p5
STYLEZAM_FIREWORKS_MONTHLY_CAP=100

STYLEZAM_QWEN_API_KEY=
STYLEZAM_QWEN_BASE_URL=https://dashscope-us.aliyuncs.com/compatible-mode/v1
STYLEZAM_QWEN_VISION_MODEL=qwen3.7-plus
STYLEZAM_QWEN_MONTHLY_CAP=100

# Optional local Grounding DINO + SAM2 + CLIP. Install with: pip install -e '.[vision]'
STYLEZAM_LOCAL_VISION_ENABLED=false
STYLEZAM_GROUNDING_DINO_MODEL=IDEA-Research/grounding-dino-tiny
STYLEZAM_SAM2_MODEL=facebook/sam2.1-hiera-tiny
STYLEZAM_CLIP_MODEL=openai/clip-vit-base-patch32

# YouCam AI Clothes v3. Keep this key on the backend only.
STYLEZAM_YOUCAM_API_KEY=
STYLEZAM_YOUCAM_BASE_URL=https://yce-api-01.makeupar.com
# Counts submitted try-on jobs, not Perfect Corp units. Set this to match your unit budget.
STYLEZAM_YOUCAM_MONTHLY_CAP=20
