# Active capture/understanding service. Never commit a filled copy of this file.
STYLEZAM_ENVIRONMENT=development
STYLEZAM_HOST=0.0.0.0
STYLEZAM_PORT=8000
STYLEZAM_DATA_DIR=.data

# Required in production. Use a random value and enter the same value in the
# app's Developer Debug screen. The iOS client accepts deployed HTTPS only.
STYLEZAM_API_TOKEN=
# Optional override. With product retrieval disabled, the API can derive this
# from the incoming Daytona HTTPS request.
STYLEZAM_PUBLIC_BASE_URL=
STYLEZAM_ALLOWED_ORIGINS=
STYLEZAM_MAX_UPLOAD_BYTES=10485760
STYLEZAM_MAX_IMAGE_PIXELS=20000000

# Product retrieval and try-on remain intentionally unavailable in this release.
STYLEZAM_PRODUCT_SEARCH_ENABLED=false
STYLEZAM_VIRTUAL_TRYON_ENABLED=false

# The iPhone defaults to five pieces; Developer Debug can request up to this cap.
STYLEZAM_GARMENT_ANALYSIS_MAX_ITEMS=12
STYLEZAM_GARMENT_ANALYSIS_TOTAL_UPLOAD_BYTES=20971520
STYLEZAM_GARMENT_ANALYSIS_CONCURRENCY=2
STYLEZAM_REQUEST_BODY_MAX_BYTES=25165824

# The only hosted image-understanding route in this release.
STYLEZAM_FIREWORKS_API_KEY=
STYLEZAM_FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
STYLEZAM_FIREWORKS_VISION_MODEL=accounts/fireworks/models/minimax-m3
# Stylezam rejects additional calls after this many requests in a UTC month.
# This is an app-side call cap, not a Fireworks billing guarantee.
STYLEZAM_FIREWORKS_MONTHLY_CAP=100
