<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key><string>Stylezam</string>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key><string>Editor</string>
            <key>CFBundleURLName</key><string>com.stylezam.app</string>
            <key>CFBundleURLSchemes</key><array><string>stylezam</string></array>
        </dict>
        <dict>
            <key>CFBundleTypeRole</key><string>Editor</string>
            <key>CFBundleURLName</key><string>Google Sign-In</string>
            <key>CFBundleURLSchemes</key><array><string>$(GOOGLE_REVERSED_CLIENT_ID)</string></array>
        </dict>
    </array>
    <key>ITSAppUsesNonExemptEncryption</key><false/>
    <key>FirebaseAppDelegateProxyEnabled</key><false/>
    <key>GOOGLE_ANALYTICS_IDFV_COLLECTION_ENABLED</key><false/>
    <key>LSRequiresIPhoneOS</key><true/>
    <key>NSCameraUsageDescription</key>
    <string>Stylezam uses the camera only when you choose to capture a fashion look.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Choose a fashion image so Stylezam can detect and separate its visible pieces on this iPhone.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Stylezam uses the microphone only while you speak a question to Stylezam AI. Audio is not saved or uploaded.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Stylezam converts a spoken question to editable text on this iPhone before you send it.</string>
    <key>NSScreenCaptureUsageDescription</key>
    <string>Stylezam scans the screen you authorize on this iPhone and automatically saves a garment only after it remains stable.</string>
    <key>NSSupportsLiveActivities</key><true/>
    <key>UIApplicationSupportsIndirectInputEvents</key><true/>
    <key>UIBackgroundModes</key>
    <array><string>screen-capture</string></array>
    <key>UILaunchScreen</key><dict><key>UIColorName</key><string>BrandCobalt</string></dict>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
</dict>
</plist>
