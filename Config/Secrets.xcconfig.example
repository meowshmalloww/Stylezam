// Signing is intentionally left to your Apple account in Xcode.
// Copy this file to Secrets.xcconfig only if you want local build overrides.
DEVELOPMENT_TEAM = YOUR_TEAM_ID

// Supabase.local.xcconfig contains public client configuration. The private
// service-role key must never be included in this repository or an app build.
STYLEZAM_SUPABASE_URL = https:/$()/YOUR_PROJECT.supabase.co
STYLEZAM_SUPABASE_PUBLISHABLE_KEY = sb_publishable_SET_ME
